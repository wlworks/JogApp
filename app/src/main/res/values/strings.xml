    <!-- Purpose statement and permission disclosures。
         setup_purpose 不在這裡：它依有沒有廣告而不同，放在 src/noAds/res 與 src/ads/res -->
    <string name="setup_privacy_policy">Privacy policy</string>
    <string name="disclosure_location_title">Why Jog needs location access</string>
    <string name="disclosure_location_body">Android requires the location permission to register a mock location provider. Jog uses it only for that: it does not read your real location, and nothing leaves this device.</string>
    <string name="disclosure_health_title">Why Jog asks for Health Connect</string>
    <string name="disclosure_health_body">Health sync is optional. When you turn it on, Jog writes the steps and distance of the simulated movement to Health Connect, so you can test apps that read them. These are simulated test values, not measurements. Jog never reads your health data, and nothing leaves this device.</string>
    <string name="disclosure_continue">Continue</string>
    <string name="disclosure_cancel">Not now</string>
