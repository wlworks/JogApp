    <string name="app_name" translatable="false">Jog</string>

    <!-- Notification -->
    <string name="notif_channel_name">Mock location running</string>
    <string name="notif_title">Jog mock location</string>
    <string name="notif_text">Standing by</string>
    <string name="notif_text_running">Simulating · %1$s</string>
    <string name="notif_action_stop">Stop</string>

    <!-- Setup screen -->
    <string name="setup_title">Jog setup</string>
    <string name="setup_subtitle">Mock location tool for development testing</string>
    <string name="setup_overlay">Display over other apps</string>
    <string name="setup_location">Location access</string>
    <string name="setup_notification">Notifications</string>
    <string name="setup_mock_app">Developer options → Select mock location app → Jog</string>
    <string name="setup_start">Start floating panel</string>
    <string name="setup_stop">Stop floating panel</string>

    <!-- Floating panel -->
    <string name="panel_query_hint">Place name or 25.033, 121.565</string>
    <string name="panel_searching">Searching…</string>
    <string name="panel_teleport">Teleport here</string>
    <string name="panel_no_location">No location set</string>
    <string name="panel_start">Start</string>
    <string name="panel_stop">Stop</string>
    <string name="cd_collapse">Collapse panel</string>
    <string name="cd_expand">Expand panel</string>
    <!-- %1$s 是依速度檔算出的距離範圍，例：80–250 m -->
    <string name="panel_random_nearby">Random jump %1$s</string>
    <string name="cd_close">Close panel</string>

    <!-- Speed tiers -->
    <string name="speed_creep">Creep</string>
    <string name="speed_walk">Walk</string>
    <string name="speed_run">Run</string>
    <string name="speed_bike">Bike</string>
    <string name="speed_drive">Drive</string>
    <string name="speed_rail">Rail</string>

    <!-- Messages -->
    <string name="msg_need_mock_app">Select Jog under Developer options → Select mock location app</string>
    <string name="msg_start_failed">Could not start: %1$s</string>
    <string name="msg_need_target">Enter a place or coordinates first</string>
    <string name="msg_not_found">No match for \"%1$s\"</string>
    <string name="msg_geocoder_unavailable">Place search unavailable — check the network, or enter coordinates instead</string>
    <string name="label_coordinates">Coordinates %1$s</string>
    <!-- %1$s 方位（compass_points）、%2$s 距離、%3$s 當時的速度檔 -->
    <string name="msg_random_jumped">Random jump %2$s %1$s (%3$s)</string>

    <!-- 八方位，索引對應 GeoMath.compassIndex：0 = N 順時針到 7 = NW -->
    <string-array name="compass_points">
        <item>north</item>
        <item>northeast</item>
        <item>east</item>
        <item>southeast</item>
        <item>south</item>
        <item>southwest</item>
        <item>west</item>
        <item>northwest</item>
    </string-array>

    <!-- Purpose statement and permission disclosures -->
    <string name="setup_purpose">Jog is a developer and QA tool for testing location-aware features such as geofences and movement handling, without leaving your desk. It only works after you choose it as the mock location app under Developer options. Jog never reads, stores, or uploads your real location, and it does not connect to the internet.</string>
    <string name="setup_privacy_policy">Privacy policy</string>
    <string name="disclosure_location_title">Why Jog needs location access</string>
    <string name="disclosure_location_body">Android requires the location permission to register a mock location provider. Jog uses it only for that: it does not read your real location, and nothing leaves this device.</string>
    <string name="disclosure_continue">Continue</string>
    <string name="disclosure_cancel">Not now</string>
</resources>
